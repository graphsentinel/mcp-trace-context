# Python MCP server image (py1, MCP Python SDK 1.30.0).
# BASE: Python image pinned by digest in scripts/versions.env (PYTHON_IMAGE). requirements-v1.txt lists the direct
# dependencies; requirements-v1.lock.txt pins every package (regenerate both together).
ARG BASE
FROM ${BASE}
WORKDIR /app
COPY requirements-v1.txt requirements-v1.lock.txt ./
RUN pip install --no-cache-dir --root-user-action=ignore -r requirements-v1.lock.txt && pip freeze > /app/pip-freeze.txt
COPY server_v1.py launch.py oa_hooks.py ./
CMD ["python3", "launch.py", "server_v1.py"]
