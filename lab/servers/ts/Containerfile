# TypeScript MCP server image (ts1). python3 is only for the in-pod stdio driver.
# BASE: Node image pinned by digest in scripts/versions.env (NODE_IMAGE).
ARG BASE
FROM ${BASE}
RUN apt-get update && apt-get install -y --no-install-recommends python3 && rm -rf /var/lib/apt/lists/*
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci --omit=dev --no-audit --no-fund && npm ls --depth=0 > /app/npm-ls.txt
COPY server.mjs oa-hooks.mjs ./
CMD ["node", "server.mjs"]
