# Pinned versions for a reproducible lab. Sourced by scripts/platform.sh and scripts/lab.sh.
# Change a value here, not in the scripts. scripts/check-versions.sh lists newer upstream releases.
# Last refreshed: 2026-10-11 (latest stable of each at that date).

# Host tools not packaged by Ubuntu, installed by scripts/platform.sh only when missing
# (Docker and python3 come from Ubuntu's packages)
K3D_VERSION=v5.9.0
KUBECTL_VERSION=v1.37.1
HELM_VERSION=v4.3.0

# Cluster (k3d runs each k3s node as a container: 1 server + 1 agent)
CLUSTER=oa-trace-context
K3S_IMAGE=docker.io/rancher/k3s:v1.37.1-k3s1

# Base images, pinned by digest. NODE_IMAGE builds the TypeScript server; PYTHON_IMAGE builds the Python servers and
# also runs the driver, the downstream API and the span reader (stdlib only).
NODE_IMAGE=docker.io/library/node:24.21.0-trixie-slim@sha256:173f125896c3b47ddf056734c7ea789d04595a6a08769a8f78e0df642781fb66
PYTHON_IMAGE=docker.io/library/python:3.14.8-slim-trixie@sha256:a2b82f3c48559aa0a8446d9af49826b6e2b2016f4cd2afabfe6013ec53729170

# Third-party runtime images (pulled, then imported into k3d)
COLLECTOR_IMAGE=docker.io/otel/opentelemetry-collector-contrib:0.162.0
AGW_IMAGE=ghcr.io/agentgateway/agentgateway:v1.6.0

# Images built from this repository (SDK versions: lab/servers/ts/package-lock.json, lab/servers/py/requirements-v*.lock.txt)
TS1_IMAGE=localhost/oa-ts1:1.32.1
PY1_IMAGE=localhost/oa-py1:1.30.0
PY2_IMAGE=localhost/oa-py2:2.3.0
